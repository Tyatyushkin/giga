{
  "model": {
    "enableOpenAILogging": true,
    "openAILoggingDir": "./logs"
  },
  "telemetry": {
    "enabled": true,
    "outfile": "./logs/telemetry/raw/run.log",
    "logPrompts": false
  },
  "permissions": {
    "allow": [
      "Bash(python3 *)",
      "Bash(/usr/local/bin/git *)",
      "Bash(find *)",
      "Bash(grep *)"
    ]
  },
  "$version": 3
}